<?xml version="1.0" encoding="utf-8"?>
<service>
  <short>Kubernetes Worker Node Ports</short>
  <description>Ports required for Kubernetes worker nodes with Cilium CNI and Hubble support per https://kubernetes.io/docs/setup/independent/install-kubeadm/</description>
  <!-- Core Kubernetes worker ports -->
  <port protocol="tcp" port="10250"/>
  <port protocol="tcp" port="30000-32767"/>
  <port protocol="udp" port="30000-32767"/>
  <!-- kube-proxy (if using kube-proxy) -->
  <port protocol="tcp" port="10256"/>
  <!-- Cilium agent ports -->
  <port protocol="tcp" port="4240"/>
  <port protocol="tcp" port="4244"/>
  <port protocol="tcp" port="4245"/>
  <!-- Hubble ports -->
  <port protocol="tcp" port="9962"/>
  <port protocol="tcp" port="9963"/>
  <port protocol="tcp" port="9964"/>
  <!-- CNI overlay networking -->
  <port protocol="udp" port="8472"/>
  <port protocol="udp" port="6081"/>
  <port protocol="udp" port="4789"/>
</service>

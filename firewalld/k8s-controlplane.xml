<?xml version="1.0" encoding="utf-8"?>
<service>
  <short>Kubernetes Control Plane Basic Ports</short>
  <description>Ports required for a Kubernetes Control Plane node per https://kubernetes.io/docs/setup/independent/install-kubeadm/</description>
  <port protocol="udp" port="500"/>
  <port protocol="udp" port="4500"/>
  <port protocol="tcp" port="6443"/>
  <port protocol="tcp" port="2379"/>
  <port protocol="tcp" port="2380"/>
  <port protocol="tcp" port="10250"/>
  <port protocol="tcp" port="10251"/>
  <port protocol="tcp" port="10252"/>
  <port protocol="tcp" port="10255"/>
  <port protocol="tcp" port="10257"/>
  <port protocol="tcp" port="10259"/>
  <!-- kube-proxy (if using kube-proxy) -->
  <port protocol="tcp" port="10256"/>
  <!-- VXLAN overlay networking -->
  <port protocol="udp" port="8472"/>
  <!-- Geneve overlay (alternative to VXLAN) -->
  <port protocol="udp" port="6081"/>
  <!-- Cilium and Hubble ports -->
  <port protocol="tcp" port="4240"/>
  <port protocol="tcp" port="4244"/>
  <port protocol="tcp" port="4245"/>
  <port protocol="tcp" port="9962"/>
  <port protocol="tcp" port="9963"/>
  <port protocol="tcp" port="9964"/>
</service>
